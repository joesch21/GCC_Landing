{
  "version": 2,
  "rewrites": [
    {
      "source": "/.well-known/gcc-agent.json",
      "destination": "/api/genesis-discovery"
    },
    {
      "source": "/tenders/GCC-GENESIS-001.json",
      "destination": "/api/genesis-tender"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/network",
      "destination": "/opportunity.html"
    },
    {
      "source": "/merch",
      "destination": "/merch.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
